node_modules/
dist/
# agent-runner ships as a JS GitHub Action — its bundled dist/ MUST be committed
# (GitHub runs action.yml `main: dist/index.js` as-is, with no build step).
!agent-runner/dist/
!agent-runner/dist/**
build/
.next/
out/
coverage/
*.tsbuildinfo
.env
.env.local
.DS_Store
.idea/
.turbo/
.pnpm-store/
*.log
.devdigest/cache/
clones/
playwright-report/
test-results/

# emdash worktree config (local)
.emdash.json

# pr-self-review output (reports, cache, waivers, history)
.devdigest/pr-self-review/

# scripts/verify.mjs result cache, keyed by tree fingerprint
.devdigest/verify/

# /run-plan run reports, one folder per plan stem
.devdigest/sdd/
