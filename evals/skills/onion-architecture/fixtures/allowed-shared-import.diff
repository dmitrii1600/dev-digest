 import type { Review } from "@devdigest/shared";
+import type { BriefSummary } from "@devdigest/shared";
+import { BRIEF_MAX_RISKS } from "./constants.js";

 export function toReviewDto(row: Review) {
   return { id: row.id, verdict: row.verdict, score: row.score };
 }
+
+export function attachBrief(dto: ReturnType<typeof toReviewDto>, brief: BriefSummary | null) {
+  return { ...dto, risks: brief ? brief.risks.slice(0, BRIEF_MAX_RISKS) : [] };
+}
